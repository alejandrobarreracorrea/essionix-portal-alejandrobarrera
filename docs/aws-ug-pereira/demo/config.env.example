# Copia este archivo a config.env y ajústalo. config.env está en .gitignore.
# Perfil AWS de TU cuenta (aislada para la práctica). No usar essionix.
PROFILE=charla
REGION=us-east-1

# Bucket S3 (nombre único global). Lo crea provision.sh
BUCKET=demo-encender-tu-idea-2026

# Se llenan tras correr provision.sh:
DISTRIBUTION_ID=
CF_DOMAIN=

# Modelo Bedrock. Verifica los disponibles con check-bedrock.sh.
# Suele requerir perfil de inferencia cross-region (prefijo us.).
# Ejemplos comunes:
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0
#   us.anthropic.claude-3-5-sonnet-20241022-v2:0
#   us.amazon.nova-pro-v1:0        (alternativa de Amazon, suele activarse al instante)
MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
MAX_TOKENS=8000
